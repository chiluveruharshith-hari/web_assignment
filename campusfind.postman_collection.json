{
  "info": {
    "name": "CampusFind — College Lost & Found Portal API",
    "description": "REST API collection for CampusFind academic project (Web Programming).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Demo\",\n  \"email\": \"newstudent@campusfind.edu\",\n  \"password\": \"StudentPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusfind.edu\",\n  \"password\": \"DevAdminPass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Get All Items (with search & filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items?type=lost&category=Electronics&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"],
              "query": [
                { "key": "type", "value": "lost" },
                { "key": "category", "value": "Electronics" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/items/:id", "host": ["{{baseUrl}}"], "path": ["api", "items", ":id"] }
          }
        },
        {
          "name": "Create Item Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Texas Instruments TI-84 Plus CE\",\n  \"type\": \"lost\",\n  \"category\": \"Electronics\",\n  \"description\": \"Black graphing calculator left in the 2nd floor library study carrel.\",\n  \"location\": \"Main Library 2nd Floor\",\n  \"incidentDate\": \"2025-10-28\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1594980596870-8aa52a78d8cd?w=600\",\n  \"contactEmail\": \"student@campusfind.edu\",\n  \"privateDetails\": \"Yellow sticker on rear battery hatch.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/items", "host": ["{{baseUrl}}"], "path": ["api", "items"] }
          }
        },
        {
          "name": "Update Item Report",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Library 2nd Floor Room 204\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/items/:id", "host": ["{{baseUrl}}"], "path": ["api", "items", ":id"] }
          }
        },
        {
          "name": "Delete Item Report",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/items/:id", "host": ["{{baseUrl}}"], "path": ["api", "items", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "Submit Ownership Claim for Found Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"explanation\": \"This is my blue water bottle that I forgot in the chemistry lab on Monday.\",\n  \"identifyingDetails\": \"Has a Yellowstone national park sticker on the bottom.\",\n  \"contactPhone\": \"555-0199\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/items/:id/claims", "host": ["{{baseUrl}}"], "path": ["api", "items", ":id", "claims"] }
          }
        },
        {
          "name": "Get My Submitted Claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/claims/my", "host": ["{{baseUrl}}"], "path": ["api", "claims", "my"] }
          }
        }
      ]
    },
