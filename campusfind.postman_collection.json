          }
        },
        {
          "name": "Update Item Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"returned\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/items/:id/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "items", ":id", "status"] }
          }
        },
        {
          "name": "Get All Claims for Admin Review",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/claims", "host": ["{{baseUrl}}"], "path": ["api", "admin", "claims"] }
          }
        },
        {
          "name": "Review Claim (Approve / Reject)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"reviewNotes\": \"Student verified identifying sticker in person at security desk.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/claims/:id", "host": ["{{baseUrl}}"], "path": ["api", "admin", "claims", ":id"] }
          }
        }
      ]
    },
