# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g., mongodb://localhost:27017/campusfind or mongodb+srv://...)
# If left empty or unreachable in development, an embedded in-memory MongoDB will be used automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/campusfind

# JWT Secret for Session/Auth Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (safe for initial dev setup)
INITIAL_ADMIN_NAME="CampusFind Administrator"
INITIAL_ADMIN_EMAIL=admin@campusfind.edu
INITIAL_ADMIN_PASSWORD=your_admin_password_here
